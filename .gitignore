# Ignore everything by default. This repo is an allowlisted ~/.pi sync repo.
*

# Repo metadata
!.gitignore
!.gitattributes

# Allow agent directory traversal
!agent/

# Hand-picked core config
!agent/AGENTS.md
!agent/keybindings.json
!agent/settings.json
!agent/models.json
!agent/model-roles.example.json
agent/model-roles.local.json

# Shared PowerShell helpers
!powershell/
!powershell/**

# Pi customizations
!agent/extensions/
!agent/extensions/**
!agent/prompts/
!agent/prompts/**
!agent/skills/
!agent/skills/**
!agent/themes/
!agent/themes/**

# Claude Code bridge (mod, Pi hub, session mirror)
!agent/claude-bridge/
!agent/claude-bridge/**
# Type files that Claude Code writes when it loads the mod
agent/claude-bridge/mod/.claude-plugin/types/

# But never track generated extension dependencies/build outputs
agent/extensions/**/node_modules/
agent/extensions/**/dist/
agent/extensions/**/build/
agent/extensions/**/coverage/
agent/extensions/**/.cache/
agent/extensions/**/.turbo/

# Per-machine Pi auth/secrets
agent/auth.json
web-smart-fetch.json

# Runtime/generated/bulky Pi state
agent/sessions/
agent/bin/
agent/npm/
agent/git/
agent/messenger/
agent/simple-messenger/
agent/codex-usage-observations.jsonl
agent/pi-crash.log
agent/*.log
agent/*.jsonl

# OS/editor/temp noise
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
desktop.ini
